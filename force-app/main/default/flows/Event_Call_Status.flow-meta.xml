    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Object</targetReference>
        </connector>
        <filterLogic>(1 OR 2 OR 3) AND 4</filterLogic>
        <filters>
            <field>Call_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Not Connected</stringValue>
            </value>
        </filters>
        <filters>
            <field>Call_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Connected Interested</stringValue>
            </value>
        </filters>
        <filters>
            <field>Call_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>TaskSubtype</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
